{
  "name": "sigeit",
  "version": "0.0.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "json-server": "npx json-server --watch db.json",
    "dashboard-sdk": "ng build --project dashboard-sdk",
    "build-projects": "ng build --project api-interfaces & ng build --project form-control-errors & ng build --project http-form-data-client & ng build --project logger & ng build --project login & ng build --project toast",
    "build-error-handler": "ng build --project error-handler",
    "lint": "ng lint",
    "inject-version": "node scripts/inject-version.js",
    "build:versioned": "npm run inject-version && ng build",
    "build:prod": "npm run inject-version && ng build --configuration production",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch",
    "release:dry": "standard-version --dry-run",
    "version:check": "standard-version --dry-run",
    "changelog": "standard-version --dry-run --skip.commit --skip.tag",
    "prepare": "husky install"
  },
  "engines": {
    "node": ">=18.17.1 <19.0.0"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.0",
    "@angular/cdk": "^16.2.0",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.0",
    "@angular/material": "^16.2.0",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/router": "^16.2.0",
    "@ngx-translate/core": "^15.0.0",
    "ajv-formats": "^2.1.1",
    "bootstrap": "^5.3.7",
    "chart.js": "^4.5.1",
    "docx": "^8.2.3",
    "file-saver": "^2.0.5",
    "json-server": "^0.17.3",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "ng2-charts": "^5.0.4",
    "ngx-toastr": "^17.0.0",
    "rxjs": "~7.8.0",
    "toastr": "^2.1.4",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.0",
    "@angular/cli": "^16.2.0",
    "@angular/compiler-cli": "^16.2.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/file-saver": "^2.0.5",
    "@types/jasmine": "~4.3.0",
    "@types/lodash": "^4.14.197",
    "@types/toastr": "^2.1.40",
    "@types/xlsx": "^0.0.35",
    "ajv": "^7.2.4",
    "husky": "^9.1.7",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "ng-packagr": "^16.2.0",
    "standard-version": "^9.5.0",
    "typescript": "~5.0.0"
  }
}
